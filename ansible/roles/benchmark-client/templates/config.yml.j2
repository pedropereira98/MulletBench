clientId: {{ inventory_hostname }}
orchestratorAddress: {{ orchestrator_ip }} 
dataFile: {{ data_file }}
dataset: {{ dataset }} #dataset name (Accel or GPSMPU)
target: {{ database }}
numWorkers: {{ num_workers }}
type: {{ type }} #INSERT or QUERY
currentTime: {{ current_time }} # if the benchmark is to use the current time for insertions and queries instead of the dataset timestamps
sharedDataset: {{ shared_dataset }} # loads whole dataset into memory (shared for all workers) instead of iterating
sharedConnection: {{ shared_connection }}
{% if type == "INSERT" -%}
insertion:
  workerSectionSize: {{ insert_volume }}
  batchSize: {{ batch_size }}
  rate: {{ insert_rate }} #batches per second
{% endif %}
{% if type == "QUERY" -%}
query:
  count: {{ query_count }} #total queries submitted per worker
  rate: {{ query_rate }} #queries per second
  aggChance: {{ agg_weight }}
  filterChance: {{ filter_weight }}
  outlierChance: {{ outlier_filter_weight }}
  downsampleChance: {{ downsample_weight }}
  numberOfLoops: {{ num_loops }}
  {% if count_outlier_filter is defined -%}
  countOutlierFilter: {{ count_outlier_filter }} 
  {% endif -%}
  {% if filter_z_score is defined -%}
  filterZScore: {{ filter_z_score }} 
  {% endif -%}
  {% if query_seed is defined -%}
  querySeed: {{ query_seed }} 
  {% endif -%}
  
  {% if ranges is defined -%}
  
  {% if ranges.aggregation is defined -%}
  {% if ranges.aggregation.percentage is defined -%}
  aggMinPercent: {{ ranges.aggregation.percentage.min }}
  aggMaxPercent: {{ ranges.aggregation.percentage.max }}
  {% endif -%}
  
  {% if ranges.aggregation.range is defined -%}
  aggMinRange: {{ ranges.aggregation.range.min }}
  aggMaxRange: {{ ranges.aggregation.range.max }}
  {% endif -%}
  {% endif -%}
  
  {% if ranges.downsample is defined -%}
  {% if ranges.downsample.percentage is defined -%}
  downsampleMinPercent: {{ ranges.downsample.percentage.min }}
  downsampleMaxPercent: {{ ranges.downsample.percentage.max }}
  {% endif -%}
  
  {% if ranges.aggregation.range is defined -%}
  downsampleMinRange: {{ ranges.downsample.range.min }}
  downsampleMaxRange: {{ ranges.downsample.range.max }}
  {% endif -%}
  {% endif -%}

  {% if ranges.outlier_filter is defined -%}
  {% if ranges.outlier_filter.percentage is defined -%}
  outlierMinPercent: {{ ranges.outlier_filter.percentage.min }}
  outlierMaxPercent: {{ ranges.outlier_filter.percentage.max }}
  {% endif -%}
  {% if ranges.outlier_filter.range is defined -%}
  outlierMinRange: {{ ranges.outlier_filter.range.min }}
  outlierMaxRange: {{ ranges.outlier_filter.range.max }}
  {% endif -%}
  {% endif -%}

  {% if ranges.filter is defined %}
  {% if ranges.filter.percentage is defined -%}
  filterMinPercent: {{ ranges.filter.percentage.min }}
  filterMaxPercent: {{ ranges.filter.percentage.max }}
  {% endif -%}
  {% if ranges.filter.range is defined -%}
  filterMinRange: {{ ranges.filter.range.min }}
  filterMaxRange: {{ ranges.filter.range.max }}
  {% endif -%}
  {% endif -%}
  
  {% else -%}
  aggMinPercent: 0.25
  aggMaxPercent: 0.25
  aggMinRange: "5s"
  aggMaxRange: "20m"
  downsampleMinPercent: 0.25
  downsampleMaxPercent: 0.25
  downsampleMinRange: "1m"
  downsampleMaxRange: "2h"
  filterMinPercent: 0.25
  filterMaxPercent: 0.25
  filterMinRange: "5s"
  filterMaxRange: "20m"
  outlierMinPercent: 0.25
  outlierMaxPercent: 0.25
  outlierMinRange: "5s"
  outlierMaxRange: "20m"
  {% endif -%}

{% endif %}

{% if database == "influx" -%}
influx:
  serverURL: "http://{{ hostvars[target]['ansible_host'] }}:{{ hostvars[target]['influx_port'] }}"
  token: {{ influx_token }}
  orgID: {{ hostvars[target]['influx_org_id'] }}
  bucket: {{ influx_bucket }}
  {% if write_timeout is defined -%}
  writeTimeout: {{ write_timeout }} 
  {% endif -%}
  {% if read_timeout is defined -%}
  readTimeout: {{ read_timeout }} 
  {% endif -%}
  {% if gzip is defined -%}
  gzip: {{ gzip }}
  {% endif -%}
{% endif %}

{% if database == "iotdb" -%}
iotdb:
  host: {{ hostvars[target]['ansible_host'] }}
  port: {{ hostvars[target]['iotdb_port'] }}
  username: "root"
  password: "root"
  devicePath: {{ hostvars[target]['iotdb_device_path'] }}
  {% if align_by_device is defined -%}
  queryAlignByDevice: {{ align_by_device }} 
  {% endif -%}
{% endif %}
